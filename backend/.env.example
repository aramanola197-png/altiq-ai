# Server
PORT=10000
NODE_ENV=production

# Frontend URL (exact match required for CORS + OAuth)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/altiq-ai?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_long_random_string_at_least_32_chars
SESSION_SECRET=replace_with_another_long_random_string
SESSION_MAX_AGE_DAYS=30

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Zero Authority DAO — official Platform API (grants, bounties, gigs, quests)
# Base URL is the platform origin; the API itself lives under /api on
# that origin (e.g. {ZADAO_API_BASE_URL}/api/bounties).
# Per the official OpenAPI spec, these read endpoints do not require
# authentication — ZADAO_API_KEY is optional and, if set, is sent as
# a Bearer token on every request (harmless if unused, may grant
# higher rate limits). Leaving it blank does not block syncing.
ZADAO_API_BASE_URL=https://zeroauthoritydao.com
ZADAO_API_KEY=

# Stacks (Phase 4)
STACKS_API_BASE_URL=https://api.mainnet.hiro.so
